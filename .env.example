# Copy this file to .env and fill in real values locally. Never commit .env
# itself (it's gitignored) -- this repo is public.

# Used by `node src/cli.js voices` (ElevenLabs). Not used by parse / lint /
# render / watch. Placeholder only -- never commit a real key.
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# PCM only (pcm_16000, pcm_22050, pcm_24000, pcm_44100). pcm_44100 needs ElevenLabs Pro.
ELEVENLABS_OUTPUT_FORMAT=pcm_24000

# Port the worker's Express server listens on (worker/src/server.js).
# The server binds to 127.0.0.1 only. The Studio browser talks to it
# directly (see docs/studio.md).
WORKER_PORT=4100

# Extra CORS origin for the Studio (http://localhost:3000 is always allowed).
# Set this to the Vercel URL later, e.g. https://studio.example.vercel.app
# STUDIO_ORIGIN=https://your-studio.vercel.app

# Optional: override the Python interpreter used to run the compositor.
# Defaults to worker/python/venv/bin/python if that venv exists.
# PYTHON_BIN=/usr/bin/python3

# Optional: absolute path to the Rhubarb Lip Sync binary if it isn't on PATH.
# RHUBARB_PATH=/usr/local/bin/rhubarb
