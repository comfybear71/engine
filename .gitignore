# Secrets - never commit real values; see .env.example
.env
.env.*
!.env.example
!**/.env.example

# Node
node_modules/
npm-debug.log*
launcher.err.log

# Python
worker/python/venv/
worker/python/**/__pycache__/
worker/python/**/*.pyc
.pytest_cache/

# Rendered output (per-project renders/ folders, e.g. projects/sample/renders/)
renders/
**/renders/

# Studio trash (soft-deleted project folders)
projects/_trash/

# Note: Rhubarb cue caches are named "<audio>.rhubarb.json" and are
# deliberately NOT gitignored -- a committed cues file is the primary
# source of truth for lip-sync (see docs/timeline-schema.md), so e.g.
# projects/sample/audio/**/*.wav.rhubarb.json is checked in on purpose.

# Script-parser throwaway output (see `node src/cli.js lint`)
.lint-timeline.json

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Future Studio (Next.js) build output
studio/.next/
studio/node_modules/
*.tsbuildinfo
